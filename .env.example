# URL pública del sitio (para SEO, sitemap y Open Graph)
NEXT_PUBLIC_SITE_URL=https://agronomicservices.com.do

# Notificación por correo de las solicitudes (opcional en la fase 1).
# Sin RESEND_API_KEY la solicitud se valida y se registra en la consola del servidor.
RESEND_API_KEY=
LEADS_NOTIFY_TO=info@agronomicservices.com.do
LEADS_NOTIFY_FROM="Agronómic Services <notificaciones@agronomicservices.com.do>"

# Fase 2 (aún no se usan)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
